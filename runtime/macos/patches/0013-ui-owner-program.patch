+/* UI owns the exact original draw program and immutable resolved inputs. This
+   boundary runs once per UI draw, independently of render-stream packetization. */
+static uint64_t ui_copy_bound(uint64_t address, size_t size, id<MTLBuffer> buffer) {
+    const uint8_t *bytes = bound_uniform_bytes(address, size, buffer);
+    if (!bytes) { periodic_ui_reject(g_periodic_ui, "unresolved buffer version"); return 0; }
+    return periodic_ui_bytes(g_periodic_ui, bytes, size);
+}
+static uint64_t ui_copy_guest(uint64_t address, size_t size) {
+    void *buffer; uint64_t offset, gpu;
+    if (!size || size > (64u << 20) || pend_hits(address, size) ||
+        !mtl_gpu_addr(address, size, &buffer, &offset, &gpu)) {
+        periodic_ui_reject(g_periodic_ui, "mutable or unbounded geometry buffer"); return 0;
+    }
+    return ui_copy_bound(gpu, size, (__bridge id<MTLBuffer>)buffer);
+}
+static int ui_copy_arguments(NvShader *sh, unsigned stage, PeriodicUIDraw *draw) {
+    if (!sh || !sh->ae) return 1;
+    NSUInteger length = sh->arg_len ? sh->arg_len : sh->ae.encodedLength;
+    if (!sh->ab_buf || !length || length > NVN_REFL_MAXB * sizeof(uint64_t) || sh->rf.abi >= 31) return 0;
+    uint64_t slots[NVN_REFL_MAXB] = {0};
+    memcpy(slots, (const uint8_t *)sh->ab_buf.contents + sh->ab_off, length);
+    registry_lock();
+    for (int i = 0; i < sh->rf.nb && periodic_ui_recording(g_periodic_ui); ++i) {
+        const nvn_rbind *b = &sh->rf.b[i];
+        unsigned reg = b->reg, aid = b->aid;
+        if (aid >= length / sizeof(uint64_t) || b->rw) { periodic_ui_reject(g_periodic_ui, "writable UI binding"); break; }
+        switch (b->kind) {
+        case NVN_RB_CBUF: {
+            const p_bind_buf *u = reg < 16 ? &S.ubo[stage][reg] : NULL;
+            void *buffer; uint64_t offset;
+            if (!u || !u->size || !mtl_addr(u->addr, u->size, &buffer, &offset)) {
+                periodic_ui_reject(g_periodic_ui, "missing UI uniform"); break;
+            }
+            slots[aid] = ui_copy_bound(slots[aid], u->size, (__bridge id<MTLBuffer>)buffer);
+            break;
+        }
+        case NVN_RB_C1: {
+            id<MTLBuffer> buffer = sh->c1buf ? sh->c1buf : zero_bank();
+            // The compiler-owned constant range is immutable for the shader's
+            // lifetime. Keep its allocation instead of copying an entire bank.
+            periodic_ui_hold(g_periodic_ui, buffer, 1); break;
+        }
+        case NVN_RB_SUPPORT:
+            periodic_ui_hold(g_periodic_ui, support_buf(), 1); break;
+        case NVN_RB_DRV0: case NVN_RB_DRV2: {
+            int bank = b->kind == NVN_RB_DRV2 ? 2 : 0;
+            if (sh->rf.drv_read[bank]) { periodic_ui_reject(g_periodic_ui, "indirect UI driver dependency"); break; }
+            periodic_ui_hold(g_periodic_ui, zero_bank(), 1); break;
+        }
+        case NVN_RB_SAMP: case NVN_RB_SAMPT: {
+            int sid = reg < 128 ? (int)((b->kind == NVN_RB_SAMPT ? S.tex[stage][reg] : S.samp[stage][reg]) >> 20) : 0;
+            id<MTLSamplerState> sampler = sid ? (__bridge id<MTLSamplerState>)samp_fast(sid) : nil;
+            if (!sampler) sampler = dummy_samp();
+            if (sampler.gpuResourceID._impl != slots[aid]) { periodic_ui_reject(g_periodic_ui, "sampler generation changed"); break; }
+            periodic_ui_hold(g_periodic_ui, sampler, 0); break;
+        }
+        case NVN_RB_TEX: {
+            int tid = reg < 128 ? (int)(S.tex[stage][reg] & 0xfffff) : 0;
+            void *pointer = NULL; if (tid) tex_fast_rid(tid, &pointer);
+            id<MTLTexture> texture = (__bridge id<MTLTexture>)pointer;
+            if (!texture) texture = dummy_tex(b->dtt, b->dpf);
+            else {
+                if (tid < g_ntreg) texture = rtsnap_bound(g_treg[tid].t.serial, texture);
+                if ((b->dtt == MTLTextureType2DArray && texture.textureType == MTLTextureType2D) ||
+                    (b->dtt == MTLTextureType2D && texture.textureType == MTLTextureType2DArray))
+                    texture = tex_type_view(texture, (MTLTextureType)b->dtt);
+            }
+            if (!texture || texture.gpuResourceID._impl != slots[aid] || texture == g_periodic_ui_canvas ||
+                texture.parentTexture == g_periodic_ui_canvas) {
+                periodic_ui_reject(g_periodic_ui, "framebuffer feedback or changed texture binding"); break;
+            }
+            if (tid && tid < g_ntreg) periodic_ui_read_range(g_periodic_ui,
+                (uint64_t)g_treg[tid].t.mem, g_treg[tid].t.L.size);
+            slots[aid] = periodic_ui_texture(g_periodic_ui, texture); break;
+        }
+        default: periodic_ui_reject(g_periodic_ui, "unsupported UI resource binding"); break;
+        }
+    }
+    registry_unlock();
+    if (!periodic_ui_recording(g_periodic_ui)) return 0;
+    uint64_t address = periodic_ui_bytes(g_periodic_ui, slots, length);
+    if (stage) { draw->fragment[sh->rf.abi] = address; draw->fragment_mask |= 1u << sh->rf.abi; }
+    else { draw->vertex[sh->rf.abi] = address; draw->vertex_mask |= 1u << sh->rf.abi; }
+    return address != 0;
+}
+static void ui_record_draw(NvProg *program, id<MTLRenderPipelineState> pipeline,
+    id<MTLDepthStencilState> depth, const p_draw *dw, const p_draw_idx *di, MTLPrimitiveType primitive) {
+    if (!periodic_ui_recording(g_periodic_ui)) return;
+    if (!R.rt.n || !R.rt.color[0] || R.rt.color[0]->serial != g_periodic_ui_owner) {
+        for (int i=0;i<R.rt.n && i<8;++i) if (R.rt.color[i]) periodic_ui_write_range(g_periodic_ui,
+            (uint64_t)R.rt.color[i]->mem,R.rt.color[i]->L.size);
+        if (R.rt.depth) periodic_ui_write_range(g_periodic_ui,(uint64_t)R.rt.depth->mem,R.rt.depth->L.size);
+        if (program) for (unsigned stage=0;stage<2;++stage) if (program->sh[stage])
+            for (int i=0;i<program->sh[stage]->rf.nb;++i) if (program->sh[stage]->rf.b[i].rw)
+                periodic_ui_reject(g_periodic_ui,"external draw writes shader storage");
+        return;
+    }
+    if (
+        !program || !program->sh[0] || !uw_ui_vs(program->sh[0]->key) ||
+        g_pass.dfmt || g_pass.sfmt || g_pass.samples != 1 || g_lay.active || g_pass.mfx) {
+        periodic_ui_reject(g_periodic_ui, "UI owner has non-UI work or unsupported attachments"); return;
+    }
+    for (unsigned i = 1; i < 8; ++i) if (g_pass.cfmt[i]) {
+        periodic_ui_reject(g_periodic_ui, "UI multiple render targets"); return;
+    }
+    PeriodicUIDraw d = {.pipeline=pipeline, .depth=depth, .viewport=g_es.vp, .scissor=g_es.sc,
+        .primitive=(uint32_t)primitive, .cull=g_es.cull, .winding=g_es.wind, .fill=g_es.fill, .clip=g_es.clip};
+    memcpy(d.bias, g_es.bias, sizeof d.bias); memcpy(d.blend, g_es.bc, sizeof d.blend);
+    if (!ui_copy_arguments(program->sh[0], 0, &d) || !ui_copy_arguments(program->sh[1], 1, &d)) {
+        periodic_ui_reject(g_periodic_ui, "unresolved UI argument program"); return;
+    }
+    uint16_t mask = vertex_stream_mask(program->sh[0]);
+    for (unsigned stream = 0; stream < 14; ++stream) if (mask & (1u << stream)) {
+        d.vertex[16 + stream] = ui_copy_guest(S.vbuf[stream].address, S.vbuf[stream].size);
+        d.vertex_mask |= 1u << (16 + stream);
+    }
+    if (mask & 0xc000) { periodic_ui_reject(g_periodic_ui, "reserved UI vertex stream"); return; }
+    const uint64_t zero[8] = {0};
+    d.vertex[30] = periodic_ui_bytes(g_periodic_ui, zero, sizeof zero); d.vertex_mask |= 1u << 30;
+    if (dw) {
+        d.count = dw->count; d.first = dw->first; d.instances = dw->instances > 1 ? dw->instances : 1; d.base_instance = dw->base_instance;
+        if (dw->prim == 7) {
+            if (dw->count > 262144) { periodic_ui_reject(g_periodic_ui, "quad index range"); return; }
+            d.indexed = 1; d.count = dw->count / 4 * 6; d.index_type = MTLIndexTypeUInt32;
+            d.index_length = (size_t)d.count * 4; d.base_vertex = dw->first;
+            uint32_t *indices = malloc(d.index_length);
+            if (!indices) { periodic_ui_reject(g_periodic_ui, "quad storage allocation"); return; }
+            for (uint32_t q = 0; q < dw->count / 4; ++q) {
+                uint32_t b = q * 4, v[6] = {b,b+1,b+2,b,b+2,b+3}; memcpy(indices+q*6,v,sizeof v);
+            }
+            d.index_address = periodic_ui_bytes(g_periodic_ui, indices, d.index_length); free(indices);
+        }
+    } else {
+        if (di->prim == 7) { periodic_ui_reject(g_periodic_ui, "unsupported UI index format"); return; }
+        d.indexed = 1; d.count = di->count; d.instances = di->instances ? di->instances : 1;
+        d.base_vertex = di->base_vertex; d.base_instance = di->base_instance;
+        d.index_type = di->itype == 1 ? MTLIndexTypeUInt16 : MTLIndexTypeUInt32;
+        d.index_length = (size_t)d.count * (di->itype == 1 ? 2 : 4);
+        if (di->itype == 0) {
+            void *buffer; uint64_t offset;
+            if (pend_hits(di->ibuf,d.count) || !mtl_addr(di->ibuf,d.count,&buffer,&offset)) {
+                periodic_ui_reject(g_periodic_ui,"GPU-written UI byte indices"); return;
+            }
+            const uint8_t *bytes=(const uint8_t *)[(__bridge id<MTLBuffer>)buffer contents]+offset;
+            uint16_t *indices=malloc((size_t)d.count*2);
+            if (!indices) { periodic_ui_reject(g_periodic_ui,"byte index allocation"); return; }
+            for (uint32_t i=0;i<d.count;++i) indices[i]=bytes[i]==255?65535:bytes[i];
+            d.index_type=MTLIndexTypeUInt16;d.index_length=(size_t)d.count*2;
+            d.index_address=periodic_ui_bytes(g_periodic_ui,indices,d.index_length);free(indices);
+        } else d.index_address = ui_copy_guest(di->ibuf, d.index_length);
+    }
+    if (periodic_ui_recording(g_periodic_ui)) periodic_ui_append(g_periodic_ui, &d);
+}
