+static inline void rs_observe(const nvn_encode_packet *p) {
+    if (!periodic_form_active()) return;
+    uint8_t fixed = 0, dynamic = 0, resources = 0, flags = 0;
+    PeriodicResourceRef refs[8];
+    switch (p->op) {
+        case RS_BEGIN:
+            fixed = 0x30; resources = 0x0f; flags = PERIODIC_PACKET_PASS_BEGIN;
+            for (unsigned i = 0; i < 4; ++i) refs[i] = (PeriodicResourceRef){.role=0x100u + i};
+            break;
+        case RS_END: fixed = 0x03; flags = PERIODIC_PACKET_PASS_END; break;
+        case RS_PSO: resources = 0x01; refs[0] = (PeriodicResourceRef){.role=1}; break;
+        case RS_DSS: resources = 0x01; refs[0] = (PeriodicResourceRef){.role=2}; break;
+        case RS_ADDRESS:
+            fixed = 0x03; resources = 0x04;
+            refs[2] = (PeriodicResourceRef){.role=0x1000u + (uint32_t)(p->u[0] << 8) + (uint32_t)p->u[1]};
+            break;
+        case RS_DRAW: fixed = 0x01; dynamic = 0x06; flags = PERIODIC_PACKET_DRAW; break;
+        case RS_INSTANCED: fixed = 0x01; dynamic = 0x1e; flags = PERIODIC_PACKET_DRAW; break;
+        case RS_INDEXED:
+            fixed = 0x05; dynamic = 0xf2; resources = 0x08; flags = PERIODIC_PACKET_DRAW;
+            refs[3] = (PeriodicResourceRef){.role=0x2000};
+            break;
+        case RS_CULL: case RS_WINDING: case RS_FILL: case RS_CLIP:
+            dynamic = 0x01; break;
+        case RS_STENCIL: dynamic = 0x03; break;
+        case RS_VIEWPORT: case RS_SCISSOR: case RS_BIAS: case RS_BLEND:
+            dynamic = 0xff; break;
+        case RS_VISIBILITY: dynamic = 0x03; break;
+        case RS_STORE: fixed = 0x07; break;
+        default: dynamic = 0xff; break;
+    }
+    periodic_observe_packet((uint32_t)p->op, p->u, fixed, dynamic, resources, flags, refs);
+}
