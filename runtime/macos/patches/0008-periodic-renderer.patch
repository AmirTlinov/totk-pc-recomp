+    rs_put((nvn_encode_packet){.op=RS_CULL,.u={g_gpu_draw.row.cull}},0);
+    rs_put((nvn_encode_packet){.op=RS_WINDING,.u={g_gpu_draw.row.winding}},0);
+    rs_put((nvn_encode_packet){.op=RS_FILL,.u={g_gpu_draw.row.fill}},0);
+    rs_put((nvn_encode_packet){.op=RS_CLIP,.u={g_gpu_draw.row.clip}},0);
+    float bias[3] = {g_gpu_draw.row.bias, g_gpu_draw.row.slope, g_gpu_draw.row.clamp};
+    rs_copy(RS_BIAS, bias, sizeof bias);
+    for (unsigned stage = 0; stage != 2; ++stage) {
+        uint32_t mask = stage ? g_gpu_draw.row.fragment_mask : g_gpu_draw.row.vertex_mask;
+        const uint64_t *addresses = stage ? g_gpu_draw.row.fragment : g_gpu_draw.row.vertex;
+        while (mask) {
+            unsigned slot = __builtin_ctz(mask); mask &= mask - 1;
+            rs_put((nvn_encode_packet){.op=RS_ADDRESS,.u={stage,slot,addresses[slot]}},0);
+        }
+    }
+}
+static int pg_draw(unsigned kind, MTLPrimitiveType primitive, NSUInteger first,
+                   NSUInteger count, NSUInteger instances, NSUInteger base_instance,
+                   NSInteger base_vertex, uint64_t index_address, uint64_t index_length) {
+    if (!g_gpu_draw.active) return 0;
+    if (!g_gpu_draw.pipeline_supported || !g_gpu_draw.pipeline_held || !g_gpu_draw.depth_held ||
+        first > UINT32_MAX || count > UINT32_MAX || instances > UINT32_MAX ||
+        base_instance > UINT32_MAX || base_vertex < INT32_MIN || base_vertex > INT32_MAX) {
+        pg_restore(); return 0;
+    }
+    g_gpu_draw.row.kind = kind; g_gpu_draw.row.primitive = (uint32_t)primitive;
+    g_gpu_draw.row.first = (uint32_t)first; g_gpu_draw.row.count = (uint32_t)count;
+    g_gpu_draw.row.instances = (uint32_t)instances; g_gpu_draw.row.base_instance = (uint32_t)base_instance;
+    g_gpu_draw.row.base_vertex = (int32_t)base_vertex;
+    g_gpu_draw.row.index_address = index_address; g_gpu_draw.row.index_length = index_length;
+    uint32_t index;
+    if (!periodic_gpu_encode_append(g_periodic_gpu_chunk, &g_gpu_draw.row, &index)) {
+        pg_restore(); return 0;
+    }
+    if (g_gpu_draw.count && index != g_gpu_draw.first + g_gpu_draw.count) pg_flush();
+    if (!g_gpu_draw.count) g_gpu_draw.first = index;
+    ++g_gpu_draw.count;
+    return 1;
+}
