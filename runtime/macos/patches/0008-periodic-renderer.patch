+/* Native draw parameters are captured before ordinary render-stream packets.
+   One immutable GPU program writes commands for the current parameter blocks.
+   This reduces encoding work; it does not certify a temporal owner or skip any
+   guest draw. External encoder state partitions the ordered indirect ranges. */
+static struct {
+    PeriodicGPUEncodeRow row;
+    uint32_t first, count;
+    int active, pipeline_supported, pipeline_held, depth_held;
+} g_gpu_draw;
+static id<MTLRenderPipelineState> g_pg_pipeline;
+static id<MTLDepthStencilState> g_pg_depth;
+
+static void pg_flush(void) {
+    if (!g_gpu_draw.count) return;
+    rs_put((nvn_encode_packet){.op = RS_GPU_RANGE, .u = {
+        (uint64_t)(uintptr_t)g_periodic_gpu_chunk.chunk,
+        g_periodic_gpu_chunk.generation, g_gpu_draw.first, g_gpu_draw.count}}, 1);
+    g_gpu_draw.count = 0;
+}
+static void pg_begin(id encoder) {
+    if (g_gpu_draw.count) MDIE("GPU draw range crossed a render-pass boundary");
+    memset(&g_gpu_draw, 0, sizeof g_gpu_draw);
+    g_pg_pipeline = nil; g_pg_depth = nil;
+    g_gpu_draw.active = g_periodic_gpu_chunk.chunk && rs_using(encoder);
+    g_gpu_draw.row.cull = MTLCullModeNone;
+    g_gpu_draw.row.winding = MTLWindingClockwise;
+    g_gpu_draw.row.fill = MTLTriangleFillModeFill;
+    g_gpu_draw.row.clip = MTLDepthClipModeClip;
+    g_gpu_draw.depth_held = 1;
+}
+static void pg_pipeline(id<MTLRenderPipelineState> pipeline) {
+    if (pipeline == g_pg_pipeline) return;
+    g_pg_pipeline = pipeline;
+    g_gpu_draw.row.pipeline = pipeline.gpuResourceID._impl;
+    g_gpu_draw.pipeline_supported = pipeline.supportIndirectCommandBuffers;
+    g_gpu_draw.pipeline_held = pipeline && periodic_gpu_encode_hold(g_periodic_gpu_chunk,
+        (__bridge void *)pipeline, 1);
+}
+static void pg_depth(id<MTLDepthStencilState> depth) {
+    if (depth == g_pg_depth) return;
+    g_pg_depth = depth;
+    g_gpu_draw.row.depth_stencil = depth.gpuResourceID._impl;
+    g_gpu_draw.depth_held = !depth || periodic_gpu_encode_hold(g_periodic_gpu_chunk,
+        (__bridge void *)depth, 0);
+}
+/* ICB execution may change explicit render state. Restore the complete current
+   state before an ordinary draw, including argument addresses that no longer
+   have individual FIFO packets in this path. External state never enters ICB. */
+static void pg_restore(void) {
+    pg_flush();
