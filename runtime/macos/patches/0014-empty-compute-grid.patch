 static void dispatch(const p_dispatch *dp) {
     zskip_clear();
+    // NVN can submit an empty grid. Metal requires every dispatched dimension
+    // to be positive; an empty dispatch has no shader or resource side effects.
+    if (!dp->x || !dp->y || !dp->z) return;
+    if (dp->x < 0 || dp->y < 0 || dp->z < 0) MDIE("negative compute dispatch dimensions");
     if (!S.prog) { RED_ONCE(27, "派发前没有绑定程序"); return; }
     __unsafe_unretained NvProg *cpr = prog_get(S.prog);
     if (prog_fit(cpr) < 0) { if (native_policy_strict()) MDIE("required native compute shader variant failed"); return; }
