+    if (!tid) return 0;
+    uint64_t generation = atomic_load_explicit(&g_tgeneration[tid], memory_order_relaxed);
+    if (generation) return generation;
+    return atomic_load_explicit(&g_towner[tid], memory_order_relaxed);
