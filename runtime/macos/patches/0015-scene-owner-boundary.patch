+// Called once around the concrete game object's draw action, before it builds
+// any ordinary commands. No per-packet owner discovery is needed.
+NativeSceneInvocation nvn_scene_begin(void *recorder, NativeSceneAddress address) {
+    cmd_t *o = recorder;
+    if (!o || o->magic != MAGIC('C','M','D','B') || !o->recording || !address.generation)
+        return (NativeSceneInvocation){0};
+    cmd_reserve(o, 0);
+    recording_prefix *r = recording_meta(o);
+    if (!r->scene_incarnation) {
+        r->scene_incarnation = atomic_fetch_add_explicit(&g_scene_incarnation, 1, memory_order_relaxed) + 1;
+        if (!r->scene_incarnation) die("scene recording incarnation overflow");
+    }
+    if (r->scene_count == r->scene_capacity) {
+        size_t capacity = r->scene_capacity ? r->scene_capacity * 2 : 64;
+        if (capacity < r->scene_capacity || capacity > SIZE_MAX / sizeof *r->scene_scopes)
+            die("scene invocation storage overflow");
+        NvnSceneScope *next = realloc(r->scene_scopes, capacity * sizeof *next);
+        if (!next) die("scene invocation storage allocation");
+        r->scene_scopes = next; r->scene_capacity = capacity;
+    }
+    size_t token = r->scene_count++;
+    r->scene_scopes[token] = (NvnSceneScope){r->logical_bytes, SIZE_MAX, address, r->scene_top};
+    r->scene_top = token + 1;
+    return (NativeSceneInvocation){r->scene_incarnation, token};
+}
+int nvn_scene_end(void *recorder, NativeSceneInvocation token) {
+    if (!token.recording) return 0;
+    cmd_t *o = recorder;
+    recording_prefix *r = recording_meta(o);
+    if (!o->recording || !r || r->scene_incarnation != token.recording) return 0;
+    if (token.index >= r->scene_count || r->scene_top != token.index + 1 ||
+        r->scene_scopes[token.index].offset > r->logical_bytes)
+        die("scene invocation crossed command recording lifetime");
+    r->scene_scopes[token.index].bytes = r->logical_bytes - r->scene_scopes[token.index].offset;
+    r->scene_top = r->scene_scopes[token.index].parent;
+    return 1;
 }
 
