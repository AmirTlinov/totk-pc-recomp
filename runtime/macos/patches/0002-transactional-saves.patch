+static void save_access_end(SaveAccess *access) {
+    if(access->held)pthread_rwlock_unlock(&snapshot_lock);
+    runtime_core_back(&access->away);
+}
+#define SAVE_ACCESS(exclusive) SaveAccess access __attribute__((cleanup(save_access_end))) = save_access(exclusive)
