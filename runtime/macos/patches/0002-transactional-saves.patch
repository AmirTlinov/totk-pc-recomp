+static SaveAccess save_access(int exclusive) {
+    SaveAccess access = {.away=runtime_core_away()};
+    int r=exclusive ? pthread_rwlock_wrlock(&snapshot_lock) : pthread_rwlock_rdlock(&snapshot_lock);
+    if(r)runtime_fail("save snapshot lock");
+    access.held=1;return access;
